# Public Discord application/client ID (not the bot token)
DISCORD_CLIENT_ID=
# Discord Developer Portal > OAuth2 > Client Secret; server-side only, never commit the value.
DISCORD_CLIENT_SECRET=

# Choose one provider for both services. Keep livekit until a Cloudflare test is successful.
STREAM_PROVIDER=livekit

# Cloudflare Realtime > Serverless SFU app; server-only secrets, never expose in browser.
CLOUDFLARE_SFU_APP_ID=
CLOUDFLARE_SFU_APP_SECRET=
# Relay only: HTTPS origin of the Activity server for authenticated SFU signaling.
SHIS_ACTIVITY_URL=

# LiveKit Cloud project
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Shared secret for the SysDVR sender and native relay; also used by the legacy token API.
STREAM_KEY=change-this-to-a-long-random-value

# Mount persistent storage here in production for shared decorations.
DECORATION_DATA_DIR=/data/decorations
# Optional separate editor password (defaults to STREAM_KEY).
DECORATION_EDIT_KEY=

DEFAULT_STREAM=cris
PORT=3000
