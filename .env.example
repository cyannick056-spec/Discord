# ID público de la aplicación de Discord. No es un token de bot.
DISCORD_CLIENT_ID=

# Discord Developer Portal > OAuth2 > Client Secret.
# Solo servidor. Nunca guardes el valor real en el repositorio.
DISCORD_CLIENT_SECRET=

# Cloudflare Realtime > Serverless SFU.
# Ambos valores son solo de servidor; nunca expongas el App Secret al navegador.
CLOUDFLARE_SFU_APP_ID=
CLOUDFLARE_SFU_APP_SECRET=

# Solo relay: origen HTTPS de la Activity usado para la señalización autenticada con el SFU.
SHIS_ACTIVITY_URL=

# Clave compartida que autentica la publicación Switch/relay.
STREAM_KEY=replace-with-a-long-random-value

# Clave separada para activar el modo host/editor.
DECORATION_EDIT_KEY=

# Almacenamiento persistente de escenas y decoraciones compartidas.
DECORATION_DATA_DIR=/data

# Nombre lógico del stream y puerto HTTP de la Activity.
DEFAULT_STREAM=shis
PORT=3000
