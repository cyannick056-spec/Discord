# Discord application/client ID (public identifier, not a bot token)
DISCORD_CLIENT_ID=

# Discord Developer Portal > OAuth2 > Client Secret.
# Server-side only. Never commit the real value.
DISCORD_CLIENT_SECRET=

# Current production transport.
STREAM_PROVIDER=cloudflare

# Cloudflare Realtime > Serverless SFU application.
# Keep both values server-side; never expose the App Secret in the browser.
CLOUDFLARE_SFU_APP_ID=
CLOUDFLARE_SFU_APP_SECRET=

# Relay only: HTTPS origin of the Activity server used for authenticated SFU signaling.
SHIS_ACTIVITY_URL=

# Shared secret used to authenticate the Switch/relay publishing path.
STREAM_KEY=replace-with-a-long-random-value

# Optional separate host/editor password. Recommended in production.
DECORATION_EDIT_KEY=

# Persistent storage for shared decorations.
DECORATION_DATA_DIR=/data

DEFAULT_STREAM=shis
PORT=3000

# Legacy compatibility only:
# The codebase still contains an older LiveKit transport/fallback path.
# These variables are not required by the current Cloudflare production setup.
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
